      ]
    },
    "Bülteni indir": {
      "main": [[{ "node": "Markdown → HTML", "type": "main", "index": 0 }]]
    },
    "Markdown → HTML": {
      "main": [[{ "node": "Mail gönder", "type": "main", "index": 0 }]]
    },
    "Mail gönder": {
